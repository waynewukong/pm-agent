{
  "name": "pm-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "NODE_ENV=development node --no-warnings=ExperimentalWarning server/index.js",
    "dev:web": "vite --config apps/web/vite.config.js --host 0.0.0.0",
    "build": "vite build --config apps/web/vite.config.js",
    "start": "NODE_ENV=production node --no-warnings=ExperimentalWarning server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.1.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
